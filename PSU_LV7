# TODO: Prikazi nekoliko primjera iz testnog skupa podataka koje je izgrađena mreza pogresno klasificirala

y_test_labels = np.argmax(y_test, axis=1) if y_test.ndim > 1 else y_test
classes = np.argmax(pred, axis=1) if pred.ndim > 1 else pred

wrong = np.where(classes != y_test_labels)[0]

print("Broj pogrešnih:", len(wrong))

plt.figure(figsize=(8, 8))

for i in range(min(9, len(wrong))):
    plt.subplot(3, 3, i + 1)
    idx = wrong[i]
    plt.imshow(x_test[idx].squeeze(), cmap="gray")
    plt.title(f"Pred: {classes[idx]}, Stvarno: {y_test_labels[idx]}")
    plt.axis("off")

plt.tight_layout()
