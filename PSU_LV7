train_loss, train_acc = model.evaluate(x_train_s, y_train_s, verbose=0)
test_loss, test_acc = model.evaluate(x_test_s, y_test_s, verbose=0)

print("Train accuracy:", train_acc)
print("Test accuracy:", test_acc)

